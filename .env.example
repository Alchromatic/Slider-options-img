# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ── Stripe (TEST MODE) ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Supabase ──
# Use the pooler's transaction mode (port 6543) rather than session mode (5432):
# session mode allows only 15 client connections in total, shared with the
# multi-model project. The app works on both (tested).
SUPABASE_CONNECTION_STRING=
# Connection pool (auth_db.get_db): max connections per process, seconds a
# request waits for a free one (then 503), seconds before an idle one is closed.
DB_POOL_MAX=8
DB_POOL_WAIT=20
DB_POOL_IDLE=60

# ── Auth ──
JWT_SECRET=

# ── OAuth — Google ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth — Facebook ──
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── OAuth redirect / frontend ──
OAUTH_REDIRECT_BASE=
FRONTEND_URL=

# ── TryColors API (measured palette profile generation — server-side ONLY) ──
# Base URL https://api.trycolors.com/v1, auth header X-API-KEY.
# Honors mixerMode="pro" + engine="2025". Free tier: 50 mixes/day, 2 req/sec.
TRYCOLORS_API_KEY=
# Bearer token required by the admin profile-generation endpoint.
ADMIN_TOKEN=

# ---- Image-library object storage (Railway / Tigris, S3-compatible) ----
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
